# Server
PORT=3001
NODE_ENV=development

# Pay year used for OPM/GSA lookups
PAY_YEAR=2025
GSA_FISCAL_YEAR=2025

# Data source base URLs (override only if OPM/GSA change their paths)
OPM_BASE_URL=https://www.opm.gov
GSA_API_BASE=https://api.gsa.gov/travel/perdiem/v2

# GSA Per Diem API key (free, from https://open.gsa.gov/api/perdiem/ via api.data.gov).
# When set, per diem lookups use the live GSA API; when empty, the bundled GSA
# snapshot (including the standard CONUS rate) is used instead.
GSA_API_KEY=

# Timeout (ms) for outbound requests to OPM/GSA
FETCH_TIMEOUT_MS=12000
